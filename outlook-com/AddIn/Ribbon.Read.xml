<?xml version="1.0" encoding="utf-8"?>
<!-- An email opened in its own window. Each button's tag is a command name from COMMANDS in public/js/main.js. -->
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="OnRibbonLoad" loadImage="LoadImage">
  <ribbon>
    <tabs>
      <tab idMso="TabReadMessage">
        <group id="ClaudeGroup" label="Claude">
          <splitButton id="ClaudeSplit" size="large">
            <toggleButton id="ClaudeToggle" label="Claude" image="claude" screentip="Claude Mail Assistant"
                          supertip="Show or hide the Claude pane. Use the arrow for quick actions on this email."
                          onAction="OnToggle" getPressed="GetPressed"/>
            <menu id="ClaudeMenu">
              <button id="ClaudeSummarize" tag="summarize" label="Summarize" onAction="OnCommand"/>
              <button id="ClaudeSpam" tag="spam" label="Spam check" onAction="OnCommand"/>
              <button id="ClaudeTriage" tag="triage" label="Triage" onAction="OnCommand"/>
              <button id="ClaudeExtract" tag="extract" label="Actions and dates" onAction="OnCommand"/>
              <button id="ClaudeDraft" tag="draft" label="Draft a reply" onAction="OnCommand"/>
              <button id="ClaudeTranslate" tag="translate" label="Translate" onAction="OnCommand"/>
            </menu>
          </splitButton>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
